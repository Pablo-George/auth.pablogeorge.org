<%- include('partials/client-head', { title: 'Authorize ' + app_name, brandColor: brand_color }) %>

<div class="client-page">
  <div class="client-card">
    <div class="client-app-header">
      <% if (logo_url) { %>
        <img src="<%= logo_url %>" alt="<%= app_name %>" class="client-app-logo-img">
      <% } else { %>
        <div class="client-app-avatar"><%= app_name[0].toUpperCase() %></div>
      <% } %>
      <h1 class="client-app-name"><%= app_name %></h1>
      <p class="client-app-sub">is requesting access to your account</p>
    </div>

    <div class="scope-list">
      <p class="scope-title">This app will be able to:</p>
      <ul>
        <% scope_list.forEach(function(s) { %>
          <li><%= s.label %></li>
        <% }) %>
      </ul>
    </div>

    <div class="authorize-actions">
      <form method="POST" action="/oauth/authorize" style="display:contents">
        <input type="hidden" name="action" value="allow">
        <button type="submit" class="btn btn-brand">Allow</button>
      </form>
      <form method="POST" action="/oauth/authorize" style="display:contents">
        <input type="hidden" name="action" value="deny">
        <button type="submit" class="btn btn-secondary">Deny</button>
      </form>
    </div>
  </div>
</div>

</body>
</html>
