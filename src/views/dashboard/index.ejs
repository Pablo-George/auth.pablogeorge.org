<%- include('../partials/head', { title: 'Dashboard' }) %>
<%- include('../partials/nav') %>

<main class="container">
  <div class="page-header">
    <div>
      <h1>Dashboard</h1>
      <p class="subtitle">Welcome back, <%= user.name %></p>
    </div>
    <div style="display:flex;gap:.5rem">
      <a href="/dashboard/apps/export" class="btn btn-secondary">Export</a>
      <a href="/dashboard/apps/new" class="btn btn-primary">New Application</a>
    </div>
  </div>

  <% if (typeof imported !== 'undefined' && imported) { %>
    <div class="alert alert-info" style="margin-bottom:1.25rem">
      Imported <%= imported %> application<%= imported === 1 ? '' : 's' %> successfully.
    </div>
  <% } %>

  <% if (typeof importError !== 'undefined' && importError) { %>
    <div class="alert alert-error" style="margin-bottom:1.25rem"><%= importError %></div>
  <% } %>

  <% if (apps.length === 0) { %>
    <div class="card empty-state">
      <h2>No applications yet</h2>
      <p>Create a new application or import from a previously exported file.</p>
      <div style="display:flex;gap:.75rem;justify-content:center">
        <a href="/dashboard/apps/new" class="btn btn-primary">Create Application</a>
      </div>
    </div>
  <% } else { %>
    <div class="app-list">
      <% apps.forEach(function(app) { %>
        <div class="card app-card">
          <div class="app-card-header">
            <div class="app-icon-sm"><%= app.name[0].toUpperCase() %></div>
            <div>
              <h3><a href="/dashboard/apps/<%= app.id %>"><%= app.name %></a></h3>
              <code class="client-id-preview"><%= app.client_id.slice(0, 8) %>...</code>
            </div>
          </div>
          <div class="app-card-actions">
            <a href="/dashboard/apps/<%= app.id %>" class="btn btn-sm btn-secondary">View</a>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>

  <details class="import-panel">
    <summary>Import applications</summary>
    <div class="import-panel-body">
      <p>Paste your <code>apps.json</code> below, or select the file. Existing apps with matching <code>client_id</code> will be updated.</p>
      <form method="POST" action="/dashboard/apps/import">
        <label class="import-file-label" for="import-file">
          Choose file
          <input type="file" id="import-file" accept=".json" onchange="loadFile(this)">
        </label>
        <textarea name="json" id="import-json" rows="6" placeholder='[{ "name": "My App", "client_id": "...", ... }]'></textarea>
        <button type="submit" class="btn btn-primary" style="margin-top:.75rem">Import</button>
      </form>
    </div>
  </details>
</main>

<script>
function loadFile(input) {
  const reader = new FileReader();
  reader.onload = (e) => { document.getElementById('import-json').value = e.target.result; };
  reader.readAsText(input.files[0]);
}
<% if (typeof imported !== 'undefined' && imported) { %>
history.replaceState(null, '', '/dashboard');
<% } %>
</script>

</body>
</html>
