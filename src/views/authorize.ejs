<%- include('partials/head', { title: 'Authorize' }) %>

<main class="container narrow">
  <div class="card">
    <div class="authorize-header">
      <div class="app-icon"><%= app_name[0].toUpperCase() %></div>
      <h1><%= app_name %></h1>
      <p class="subtitle">is requesting access to your account</p>
    </div>

    <div class="scope-list">
      <p class="scope-title">This app will be able to:</p>
      <ul>
        <% scope_list.forEach(function(s) { %>
          <li><%= s.label %></li>
        <% }) %>
      </ul>
    </div>

    <div class="authorize-actions">
      <form method="POST" action="/oauth/authorize" style="display:inline">
        <input type="hidden" name="action" value="allow">
        <button type="submit" class="btn btn-primary">Allow</button>
      </form>
      <form method="POST" action="/oauth/authorize" style="display:inline">
        <input type="hidden" name="action" value="deny">
        <button type="submit" class="btn btn-secondary">Deny</button>
      </form>
    </div>
  </div>
</main>

</body>
</html>
