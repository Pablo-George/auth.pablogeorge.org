<%- include('../partials/head', { title: 'New Application' }) %>
<%- include('../partials/nav') %>

<main class="container narrow">
  <div class="page-header">
    <a href="/dashboard" class="back-link">← Back</a>
  </div>
  <div class="card">
    <h1>Register Application</h1>
    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>
    <form method="POST" action="/dashboard/apps/new">
      <div class="field">
        <label for="name">Application Name</label>
        <input type="text" id="name" name="name" value="<%= values.name || '' %>" required placeholder="My App">
      </div>
      <div class="field">
        <label for="redirect_uris">Allowed Redirect URIs <span class="hint">(one per line)</span></label>
        <textarea id="redirect_uris" name="redirect_uris" rows="3" required placeholder="http://localhost:4000/callback"><%= values.redirect_uris || '' %></textarea>
      </div>

      <hr class="form-divider">
      <p class="form-section-label">Login page branding</p>
      <p class="hint" style="margin-bottom:1rem">Shown to your users when they sign in. No AuthServer branding visible.</p>

      <div class="field">
        <label for="logo_url">Logo URL <span class="hint">(optional — https image link)</span></label>
        <input type="url" id="logo_url" name="logo_url" value="<%= values.logo_url || '' %>" placeholder="https://example.com/logo.png">
      </div>
      <div class="field">
        <label for="brand_color">Brand Color <span class="hint">(hex, e.g. #e11d48)</span></label>
        <div class="color-input-row">
          <input type="color" id="brand_color_picker" value="<%= values.brand_color || '#4f46e5' %>" oninput="document.getElementById('brand_color').value=this.value">
          <input type="text" id="brand_color" name="brand_color" value="<%= values.brand_color || '#4f46e5' %>" pattern="^#[0-9a-fA-F]{6}$" placeholder="#4f46e5" oninput="document.getElementById('brand_color_picker').value=this.value">
        </div>
      </div>

      <hr class="form-divider">
      <div class="field toggle-field">
        <label class="toggle-label">
          <input type="checkbox" name="requires_payment" value="1" id="requires-payment"
            <%= values.requires_payment === '1' ? 'checked' : '' %>>
          <span>Require payment to register</span>
        </label>
        <p class="hint" style="margin-top:.25rem">Users must pay once before completing registration for this app.</p>
      </div>

      <div id="payment-fields" style="display:<%= values.requires_payment === '1' ? 'block' : 'none' %>">
        <div class="payment-fields-inner">
          <div class="field">
            <label for="payment_amount">Amount (USD)</label>
            <input type="number" id="payment_amount" name="payment_amount" step="0.01" min="0.50"
              value="<%= values.payment_amount || '' %>" placeholder="9.99">
          </div>
          <div class="field">
            <label for="payment_app_id">Payment App ID <span class="hint">(from payment.pablogeorge.org)</span></label>
            <input type="text" id="payment_app_id" name="payment_app_id"
              value="<%= values.payment_app_id || '' %>" placeholder="a1b2c3d4">
          </div>
          <div class="field">
            <label for="payment_api_key">Payment API Key <span class="hint">(from payment.pablogeorge.org)</span></label>
            <input type="text" id="payment_api_key" name="payment_api_key"
              value="<%= values.payment_api_key || '' %>">
          </div>
        </div>
      </div>

      <button type="submit" class="btn btn-primary">Create Application</button>
    </form>
  </div>
</main>

<script>
document.getElementById('requires-payment').addEventListener('change', function () {
  document.getElementById('payment-fields').style.display = this.checked ? 'block' : 'none';
});
</script>

</body>
</html>
